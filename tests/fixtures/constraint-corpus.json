{
  "version": 2,
  "cases": [
    {"name": "multi-tag multiply", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "x", "tags": ["somber", "tense"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}, "tense": {"mode": "reduce", "factor": 0.5}}},
     "exceptions": [], "expect": 1.0},
    {"name": "multi-pick multiply", "picks": [{"value": "rain", "tags": ["rainy"]}, {"value": "frost", "tags": ["cold"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}}, "cold": {"somber": {"mode": "boost", "factor": 3.0}}},
     "exceptions": [], "expect": 6.0},
    {"name": "exclude absorbing", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "exclude", "factor": 0.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "exception replaces matrix", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}}},
     "exceptions": [{"source_value": "rain", "target_value": "blue", "mode": "reduce", "factor": 0.25}], "expect": 0.25},

    {"name": "accepts axis ORs — sibling exclude does not kill an allowed tag",
     "picks": [{"value": "white t-shirt, denim skirt",
                "tags": ["casual", "sneakers", "high_heels", "sandals"],
                "axes": {"SHOES": ["sneakers", "high_heels", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "strappy sandals", "tags": ["sandals"]},
     "matrix": {"sneakers": {"sandals": {"mode": "exclude"}},
                "high_heels": {"sandals": {"mode": "exclude"}},
                "sandals": {"sandals": {"mode": "allow"}}},
     "exceptions": [], "expect": 1.0},
    {"name": "accepts axis ORs — an option outside the menu still dies",
     "picks": [{"value": "white t-shirt, denim skirt",
                "tags": ["casual", "sneakers", "high_heels", "sandals"],
                "axes": {"SHOES": ["sneakers", "high_heels", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "leather boots", "tags": ["boots"]},
     "matrix": {"sneakers": {"boots": {"mode": "exclude"}},
                "high_heels": {"boots": {"mode": "exclude"}},
                "sandals": {"boots": {"mode": "exclude"}}},
     "exceptions": [], "expect": "EXCLUDE"},
    {"name": "classify tags still multiply alongside an accepts axis",
     "picks": [{"value": "white t-shirt",
                "tags": ["casual", "sneakers", "sandals"],
                "axes": {"SHOES": ["sneakers", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "x", "tags": ["sandals", "loud"]},
     "matrix": {"sneakers": {"sandals": {"mode": "boost", "factor": 3.0}},
                "sandals": {"sandals": {"mode": "boost", "factor": 2.0}},
                "casual": {"loud": {"mode": "reduce", "factor": 0.5}}},
     "exceptions": [], "expect": 1.5},
    {"name": "axis present but kind omitted — folds as today",
     "picks": [{"value": "white t-shirt",
                "tags": ["sneakers", "sandals"],
                "axes": {"SHOES": ["sneakers", "sandals"]}}],
     "option": {"value": "strappy sandals", "tags": ["sandals"]},
     "matrix": {"sneakers": {"sandals": {"mode": "exclude"}},
                "sandals": {"sandals": {"mode": "allow"}}},
     "exceptions": [], "expect": "EXCLUDE"}
  ],
  "branch_key_cases": [
    {"name": "if-branch", "rule_id": "r1", "branch": 0, "key": "r1:0"},
    {"name": "elif-branch-1", "rule_id": "r1", "branch": 1, "key": "r1:1"},
    {"name": "elif-branch-2", "rule_id": "r1", "branch": 2, "key": "r1:2"},
    {"name": "else-branch", "rule_id": "r1", "branch": "else", "key": "r1:else"},
    {"name": "uuid-rule-if", "rule_id": "ab12cd34", "branch": 0, "key": "ab12cd34:0"},
    {"name": "uuid-rule-else", "rule_id": "ab12cd34", "branch": "else", "key": "ab12cd34:else"}
  ]
}
