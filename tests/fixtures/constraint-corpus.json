{
  "version": 2,
  "cases": [
    {"name": "multi-tag multiply", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "x", "tags": ["somber", "tense"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}, "tense": {"mode": "reduce", "factor": 0.5}}},
     "exceptions": [], "expect": 1.0},
    {"name": "multi-pick multiply", "picks": [{"value": "rain", "tags": ["rainy"]}, {"value": "frost", "tags": ["cold"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}}, "cold": {"somber": {"mode": "boost", "factor": 3.0}}},
     "exceptions": [], "expect": 6.0},
    {"name": "exclude absorbing", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "exclude", "factor": 0.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "exception replaces matrix", "picks": [{"value": "rain", "tags": ["rainy"]}],
     "option": {"value": "blue", "tags": ["somber"]},
     "matrix": {"rainy": {"somber": {"mode": "boost", "factor": 2.0}}},
     "exceptions": [{"source_value": "rain", "target_value": "blue", "mode": "reduce", "factor": 0.25}], "expect": 0.25},

    {"name": "accepts axis ORs — sibling exclude does not kill an allowed tag",
     "picks": [{"value": "white t-shirt, denim skirt",
                "tags": ["casual", "sneakers", "high_heels", "sandals"],
                "axes": {"SHOES": ["sneakers", "high_heels", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "strappy sandals", "tags": ["sandals"]},
     "matrix": {"sneakers": {"sandals": {"mode": "exclude"}},
                "high_heels": {"sandals": {"mode": "exclude"}},
                "sandals": {"sandals": {"mode": "allow"}}},
     "exceptions": [], "expect": 1.0},
    {"name": "accepts axis ORs — an option outside the menu still dies",
     "picks": [{"value": "white t-shirt, denim skirt",
                "tags": ["casual", "sneakers", "high_heels", "sandals"],
                "axes": {"SHOES": ["sneakers", "high_heels", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "leather boots", "tags": ["boots"]},
     "matrix": {"sneakers": {"boots": {"mode": "exclude"}},
                "high_heels": {"boots": {"mode": "exclude"}},
                "sandals": {"boots": {"mode": "exclude"}}},
     "exceptions": [], "expect": "EXCLUDE"},
    {"name": "classify tags still multiply alongside an accepts axis",
     "picks": [{"value": "white t-shirt",
                "tags": ["casual", "sneakers", "sandals"],
                "axes": {"SHOES": ["sneakers", "sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "x", "tags": ["sandals", "loud"]},
     "matrix": {"sneakers": {"sandals": {"mode": "boost", "factor": 3.0}},
                "sandals": {"sandals": {"mode": "boost", "factor": 2.0}},
                "casual": {"loud": {"mode": "reduce", "factor": 0.5}}},
     "exceptions": [], "expect": 1.5},
    {"name": "axis present but kind omitted — folds as today",
     "picks": [{"value": "white t-shirt",
                "tags": ["sneakers", "sandals"],
                "axes": {"SHOES": ["sneakers", "sandals"]}}],
     "option": {"value": "strappy sandals", "tags": ["sandals"]},
     "matrix": {"sneakers": {"sandals": {"mode": "exclude"}},
                "sandals": {"sandals": {"mode": "allow"}}},
     "exceptions": [], "expect": "EXCLUDE"},

    {"name": "target accepts axis ORs — multi-tag target survives an allowed alternative",
     "picks": [{"value": "outfitA", "tags": ["sandals"], "axes": {"SHOES": ["sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "combo", "tags": ["sandals", "high_heels"]},
     "target_axes": {"SHOES": ["sneakers", "high_heels", "sandals", "boots"]},
     "matrix": {"sandals": {"sandals": {"mode": "allow"}, "high_heels": {"mode": "exclude"}}},
     "exceptions": [], "expect": 1.0},
    {"name": "target accepts axis dies only when every alternative is excluded",
     "picks": [{"value": "outfitA", "tags": ["sneakers"], "axes": {"SHOES": ["sneakers"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "combo", "tags": ["sandals", "high_heels"]},
     "target_axes": {"SHOES": ["sneakers", "high_heels", "sandals", "boots"]},
     "matrix": {"sneakers": {"sandals": {"mode": "exclude"}, "high_heels": {"mode": "exclude"}}},
     "exceptions": [], "expect": "EXCLUDE"},
    {"name": "target classify tag still multiplies beside a target accepts axis",
     "picks": [{"value": "outfitA", "tags": ["sandals"], "axes": {"SHOES": ["sandals"]}}],
     "source_axis_kinds": {"SHOES": "accepts"},
     "option": {"value": "x", "tags": ["sandals", "high_heels", "loud"]},
     "target_axes": {"SHOES": ["sneakers", "high_heels", "sandals", "boots"]},
     "matrix": {"sandals": {"sandals": {"mode": "allow"}, "high_heels": {"mode": "exclude"}, "loud": {"mode": "reduce", "factor": 0.5}}},
     "exceptions": [], "expect": 0.5},

    {"name": "only exception keeps the linked target", "picks": [{"value": "maid", "tags": []}],
     "option": {"value": "frilled apron", "tags": []}, "matrix": {}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}], "expect": 1.0},
    {"name": "only exception shuts out an unmentioned target", "picks": [{"value": "maid", "tags": []}],
     "option": {"value": "leather jacket", "tags": []}, "matrix": {}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}], "expect": "EXCLUDE"},
    {"name": "only exception leaves other source values alone", "picks": [{"value": "biker", "tags": []}],
     "option": {"value": "leather jacket", "tags": []}, "matrix": {}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}], "expect": 1.0},
    {"name": "only exception keeps a target that has its own boost", "picks": [{"value": "maid", "tags": []}],
     "option": {"value": "lace gloves", "tags": []}, "matrix": {}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}, {"source_value": "maid", "target_value": "lace gloves", "mode": "boost", "factor": 2.0}], "expect": 2.0},
    {"name": "only exception beats a matrix boost on an unmentioned target", "picks": [{"value": "maid", "tags": ["formal"]}],
     "option": {"value": "tuxedo", "tags": ["formal"]}, "matrix": {"formal": {"formal": {"mode": "boost", "factor": 3.0}}}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}], "expect": "EXCLUDE"},
    {"name": "only cell keeps an option carrying the linked tag", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "sandals", "tags": ["open", "casual"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}}}, "exceptions": [], "expect": 1.0},
    {"name": "only cell shuts out an option with no mentioned tag", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "boots", "tags": ["closed"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "only cell shuts out an untagged option", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "socks", "tags": []}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "only row keeps a mentioned tag's own rule", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "flip flops", "tags": ["cheap"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}, "cheap": {"mode": "reduce", "factor": 0.5}}}, "exceptions": [], "expect": 0.5},
    {"name": "only row still honours exclude on a mentioned tag", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "cheap sandals", "tags": ["open", "cheap"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}, "cheap": {"mode": "exclude", "factor": 0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "only on one source tag gates even when another tag boosts", "picks": [{"value": "beach", "tags": ["summer", "sporty"]}],
     "option": {"value": "sneakers", "tags": ["closed"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}}, "sporty": {"closed": {"mode": "boost", "factor": 2.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "only row: an unmentioned target accepts member offers nothing", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "any shoe", "tags": ["open", "closed"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}}}, "exceptions": [], "target_axes": {"STYLE": ["open", "closed"]}, "expect": 1.0},
    {"name": "only row: a reduced accepts member is not rescued by an unmentioned sibling", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "any shoe", "tags": ["open", "closed"]}, "matrix": {"summer": {"open": {"mode": "reduce", "factor": 0.5}, "cheap": {"mode": "only", "factor": 1.0}}}, "exceptions": [], "target_axes": {"STYLE": ["open", "closed"]}, "expect": 0.5},
    {"name": "only row: a neutral allow cell is not a mention", "picks": [{"value": "beach", "tags": ["summer"]}],
     "option": {"value": "boots", "tags": ["closed"]}, "matrix": {"summer": {"open": {"mode": "only", "factor": 1.0}, "closed": {"mode": "allow", "factor": 1.0}}}, "exceptions": [], "expect": "EXCLUDE"},
    {"name": "only exception: an allow exception is a mention", "picks": [{"value": "maid", "tags": []}],
     "option": {"value": "sundress", "tags": []}, "matrix": {}, "exceptions": [{"source_value": "maid", "target_value": "frilled apron", "mode": "only", "factor": 1.0}, {"source_value": "maid", "target_value": "sundress", "mode": "allow", "factor": 1.0}], "expect": 1.0}
  ],
  "branch_key_cases": [
