 "derivations": [
  {
   "id": "b0000031",
   "type": "derivation",
   "name": "Title from class",
   "description": "Gives each class a title.",
   "category_id": "bench_characters",
   "tags": [
    "bench"
   ],
   "is_favorite": false,
   "payload": {
    "rules": [
     {
      "id": "r001",
      "branches": [
       {
        "condition": {
         "var": "class",
         "op": "equals",
         "value": "mage"
        },
        "action": {
         "target_var": "title",
         "mode": "replace",
         "value": "Archmage"
        }
       },
       {
        "condition": {
         "var": "class",
         "op": "equals",
         "value": "warrior"
        },
        "action": {
         "target_var": "title",
         "mode": "replace",
         "value": "Warlord"
        }
       }
      ],
      "else": {
       "action": {
        "target_var": "title",
